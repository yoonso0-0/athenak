# AthenaK input file: 2D BHL wind tunnel with a wind-emitting spherical mask
#
# Cheap 2D pilot for the point-particle gravity source term and the spherical_wind
# <sphere_mask>. The mesh is a plane but the potential is still the 3D GM/r one, so this
# is qualitative, not a quantitative BHL measurement. The mask is an inner boundary
# condition, not a sink: measure accretion as minus the net outward mass flux through a
# shell outside r_mask, not as mass lost from the box.
#
# Caveats:
#  - Half-plane domain (x2 >= 0, ix2_bc = reflect): the solution is exactly mirror
#    symmetric about y = 0 at every stage, so this setup cannot show up-down symmetry
#    breaking, and the net y-momentum history column is not a diagnostic of it.
#  - plm/hlle is much more diffusive than ppm4/hllc and changes the bubble dynamics
#    qualitatively; cross-check against a higher-order run before trusting standoff or
#    pulsation behavior.
#  - The transverse (x2) wall is often reached well before tlim, after which the flow is
#    not reliably physical. Check the far-wall breach time using row [-1] only; row [0] is
#    the reflect boundary.
#  - ix1_bc = user clamps all upstream fields and ox1_bc = outflow assumes every
#    characteristic exits, so both are valid only for supersonic flow. With vel_inf <
#    cs_inf expect spurious standing waves and drift.
#
# Mesh: a single MeshBlock spans the domain. spherical_wind places no constraint on the
# block layout, but the origin lies on the ix2 boundary of this half-plane.

<comment>
problem   = 2D BHL wind tunnel past a wind-emitting GM=1 point mass

<job>
basename  = BHLWind2D

<mesh>
nghost    = 4          # Number of ghost cells (ppm4 needs 3, ppm4 + fofc needs 4)
nx1       = 600        # Number of zones in X1-direction (dx = 0.1667)
x1min     = -30.0      # minimum value of X1 -- upstream buffer, asymmetric about the mask
x1max     = 70.0       # maximum value of X1 -- downstream buffer, asymmetric about the mask
ix1_bc    = user       # inner-X1 (upstream) boundary: held at the uniform wind
ox1_bc    = outflow    # outer-X1 (downstream) boundary: let the wake leave

nx2       = 300        # Number of zones in X2-direction (dx = 0.1667, unchanged)
x2min     = 0.0        # HALF-PLANE domain: y < 0 is reconstructed by the reflect BC below,
                       # not simulated -- see the half-plane caveat above
x2max     = 50.0       # maximum value of X2
ix2_bc    = reflect    # inner-X2 boundary flag: imposes exact up-down mirror symmetry
                       # every stage -- see the half-plane caveat above
ox2_bc    = outflow    # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction (2D)
x3min     = -0.5       # symmetric about 0 so the x3 cell center sits on the point mass
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 600        # single MeshBlock spans the full domain
nx2       = 300
nx3       = 1

<time>
evolution  = dynamic   # dynamic/kinematic/static
integrator = rk2       # time integration algorithm
cfl_number = 0.3       # timestep safety factor
nlim       = -1        # cycle limit
tlim       = 500.0     # time limit
ndiag      = 500       # cycles between diagostic output

<hydro>
eos         = ideal    # EOS type
reconstruct = ppm4     # 4th-order -- scheme choice affects qualitative dynamics here,
                       # see NUMERICS CAVEAT above
rsolver     = hlle     # diffusive, does not resolve contacts exactly -- see NUMERICS
                       # CAVEAT above
gamma       = 1.666666666667   # gamma = C_p/C_v
fofc        = true     # first-order flux correction: the wind driving into the ambient
                       # makes strong rarefactions that can turn into negative
                       # pressure/density right outside the mask
dfloor      = 1.0e-6   # far below anything physical here (ambient density is 1), so the
pfloor      = 1.0e-8   # floors only ever catch a genuine solver failure
nscalars    = 1        # passive scalar s: mass fraction of wind material from the mask

<hydro_srcterms>
point_particle_gravity_at_center = true   # GM=1 point mass at the coordinate origin
gravity_softening_length         = 1.0    # equals the mask radius, so the field is
                                          # exactly GM/r^2 everywhere outside the mask

<problem>
pgen_name = bhl_wind_tunnel
dens_inf  = 1.0        # upstream density
cs_inf    = 0.3        # upstream sound speed
vel_inf   = 0.6        # upstream speed, Mach 2: SUPERSONIC wind

<sphere_mask>
enabled   = true
radius    = 1.0        # 0.23 R_B (supersonic: R_B = 2GM/(vel_inf^2+cs_inf^2) = 4.44)
bc        = spherical_wind
dens      = 0.1        # density of the injected wind at the mask surface
eint      = 0.5        # energy density of the injected wind (p_w = (gamma-1)*eint = 0.333,
                       # NOT specific internal energy -- see hydro_sphere_mask.cpp, w0_(IEN)
                       # is set directly from this value with no density factor)
vel_r     = 2.0        # outward radial velocity at the mask surface (>0 = wind)
scalar    = 1.0        # passive scalar s in the mask (s = 0 upstream)

<output1>
file_type   = hst      # history data dump
data_format = %12.5e   # optional data format string
dt          = 1.0      # time increment between outputs

<output2>
file_type  = bin       # AthenaK native binary dump
variable   = hydro_w   # variables to be output
dt         = 1.0       # time increment between outputs -> 201 frames
