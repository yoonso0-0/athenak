# AthenaK input file: spherical inner mask (Dirichlet) test, 3D
# 3D analog of sphere_mask_dirichlet.athinput: the same corner-anchored octant domain and
# Liska & Wendroff implosion IC (which is z-independent), extruded in x3 and driven with
# reflect BCs on all three inner faces. The sphere r=sqrt(x1^2+x2^2+x3^2) < radius is
# genuinely 3D even though the IC has no z-dependence, exercising the trilinear
# mirror-point interpolation and k-direction indexing paths not touched by the 2D test.

<comment>
problem   = spherical inner mask (Dirichlet) regression test, 3D

<job>
basename  = SphereMaskReflecting3D

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 24         # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 0.3        # maximum value of X1
ix1_bc    = reflect    # inner-X1 boundary flag
ox1_bc    = reflect    # outer-X1 boundary flag

nx2       = 24         # Number of zones in X2-direction
x2min     = 0.0        # minimum value of X2
x2max     = 0.3        # maximum value of X2
ix2_bc    = reflect    # inner-X2 boundary flag
ox2_bc    = reflect    # outer-X2 boundary flag

nx3       = 24         # Number of zones in X3-direction
x3min     = 0.0        # minimum value of X3
x3max     = 0.3        # maximum value of X3
ix3_bc    = reflect    # inner-X3 boundary flag
ox3_bc    = reflect    # outer-X3 boundary flag

<meshblock>
nx1       = 24         # single MeshBlock spans the full (octant-like) domain
nx2       = 24
nx3       = 24

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk2        # time integration algorithm
cfl_number = 0.4        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 0.1        # time limit
ndiag      = 200        # cycles between diagostic output

<hydro>
eos         = ideal     # EOS type
reconstruct = plm       # spatial reconstruction method
rsolver     = llf       # Riemann-solver to be used
gamma       = 1.4       # gamma = C_p/C_v

<problem>
pgen_name = implode     # problem generator name
# Interior Conditions (near the origin)
d_in  = 0.125           # density
p_in  = 0.14            # pressure

# Exterior Conditions
d_out  = 1.0            # density
p_out  = 1.0            # pressure

<sphere_mask>
enabled   = true
radius    = 0.05        # 2*radius=0.1 << domain size=0.3 (single MeshBlock)
bc        = reflecting
dens      = 2.0
vel1      = 0.0
vel2      = 0.0
vel3      = 0.0
pres      = 8.0

<output1>
file_type   = hst       # history data dump
data_format = %12.5e    # optional data format string
dt          = 0.02      # time increment between outputs

<output2>
file_type  = bin        # AthenaK native binary dump
variable   = hydro_w    # variables to be output
dt         = 0.02       # time increment between outputs
