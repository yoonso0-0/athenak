# AthenaK input file: spherical inner mask (Dirichlet) test, 2D, symmetric domain
# Same Liska & Wendroff implosion setup as sphere_mask_dirichlet.athinput, but run on a
# domain symmetric about the origin ([-0.3,0.3]^2, reflecting BCs on all four outer
# faces) instead of an octant with the origin at a corner. A single MeshBlock spans the
# whole domain, so it trivially owns the origin and the full 2*radius mirror
# neighborhood in *every* direction -- exercising the InitSphereMask containment check
# on genuine +/- extents, not just the positive-axis-only case of the octant setup.

<comment>
problem   = spherical inner mask (Dirichlet) regression test, 2D, symmetric domain

<job>
basename  = SphereMaskDirichletSym

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 64         # Number of zones in X1-direction
x1min     = -0.3       # minimum value of X1
x1max     = 0.3        # maximum value of X1
ix1_bc    = reflect    # inner-X1 boundary flag
ox1_bc    = reflect    # outer-X1 boundary flag

nx2       = 64         # Number of zones in X2-direction
x2min     = -0.3       # minimum value of X2
x2max     = 0.3        # maximum value of X2
ix2_bc    = reflect    # inner-X2 boundary flag
ox2_bc    = reflect    # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 64         # single MeshBlock spans the full symmetric domain
nx2       = 64
nx3       = 1

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk2        # time integration algorithm
cfl_number = 0.4        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 0.1        # time limit
ndiag      = 200        # cycles between diagostic output

<hydro>
eos         = ideal     # EOS type
reconstruct = plm       # spatial reconstruction method
rsolver     = llf       # Riemann-solver to be used
gamma       = 1.4       # gamma = C_p/C_v

<problem>
pgen_name = implode     # problem generator name
# Interior Conditions (near the origin)
d_in  = 0.125           # density
p_in  = 0.14            # pressure

# Exterior Conditions
d_out  = 1.0            # density
p_out  = 1.0            # pressure

<sphere_mask>
enabled   = true
radius    = 0.05        # 2*radius+margin=0.109 << half-domain=0.3 in every direction
bc        = dirichlet
dens      = 2.0
vel1      = 0.0
vel2      = 0.0
vel3      = 0.0
eint      = 20.0
vel_r     = 0.3         # only read by bc=spherical_wind; present so tests can override it

<output1>
file_type   = hst       # history data dump
data_format = %12.5e    # optional data format string
dt          = 0.02      # time increment between outputs

<output2>
file_type  = bin        # AthenaK native binary dump
variable   = hydro_w    # variables to be output
dt         = 0.02       # time increment between outputs
